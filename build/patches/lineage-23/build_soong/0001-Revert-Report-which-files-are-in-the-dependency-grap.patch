 ui/build/build.go         |   1 -
 ui/build/ninja.go         |  44 -----------------
 ui/build/source_inputs.go | 100 --------------------------------------
 4 files changed, 146 deletions(-)
 delete mode 100644 ui/build/source_inputs.go

