+    gAppVolumeCstor = GetMethodIDOrDie(env, AppVolumeClass, "<init>",
+            "(Ljava/lang/String;ZFZ)V");
 
     AudioSystem::addErrorCallback(android_media_AudioSystem_error_callback);
 
