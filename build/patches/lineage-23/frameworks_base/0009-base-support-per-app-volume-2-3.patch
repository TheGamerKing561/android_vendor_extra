     gRunnableClassInfo.run = GetMethodIDOrDie(env, runnableClazz, "run", "()V");
 
     LOG_ALWAYS_FATAL_IF(env->GetJavaVM(&gVm) != 0);
+    jclass AppVolumeClass = FindClassOrDie(env, "android/media/AppVolume");
