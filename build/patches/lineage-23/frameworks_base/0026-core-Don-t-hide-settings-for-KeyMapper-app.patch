From 42efc58f77af00354a1f295ed127c510fa2e24fe Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Tue, 5 May 2026 23:39:17 +0200
Subject: [PATCH 26/26] core: Don't hide settings for `KeyMapper` app

Change-Id: I0b4b6b414a0ff1ed3fb2bead4bafd02ed0b88580
---
 core/java/android/provider/Settings.java | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/core/java/android/provider/Settings.java b/core/java/android/provider/Settings.java
index 3f9e50a1a..ba4e1bf7e 100644
--- a/core/java/android/provider/Settings.java
+++ b/core/java/android/provider/Settings.java
@@ -22749,6 +22749,7 @@ public final class Settings {
     private static boolean isCallerSystemApp(@NonNull String packageName) {
         return packageName.equals("android") ||
                packageName.startsWith("com.android.") ||
-               packageName.equals("com.google.android.settings.intelligence");
+               packageName.equals("com.google.android.settings.intelligence") ||
+               packageName.equals("io.github.sds100.keymapper");
     }
 }
