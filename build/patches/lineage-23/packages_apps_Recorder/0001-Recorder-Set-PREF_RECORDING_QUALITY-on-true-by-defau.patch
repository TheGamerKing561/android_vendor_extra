From dcd0b65c791992f3360335f0b1e81be3ae2a8229 Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Wed, 21 May 2025 19:19:25 +0200
Subject: [PATCH] Recorder: Set `PREF_RECORDING_QUALITY` on true by default

Change-Id: I8a0b51cafce898ed2e381b5b7d4a4fd36cc6c85f
---
 .../java/org/lineageos/recorder/utils/PreferencesManager.kt     | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/app/src/main/java/org/lineageos/recorder/utils/PreferencesManager.kt b/app/src/main/java/org/lineageos/recorder/utils/PreferencesManager.kt
index e289297..ee64e6e 100644
--- a/app/src/main/java/org/lineageos/recorder/utils/PreferencesManager.kt
+++ b/app/src/main/java/org/lineageos/recorder/utils/PreferencesManager.kt
@@ -12,7 +12,7 @@ class PreferencesManager(context: Context) {
     private val preferences = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
 
     var recordInHighQuality: Boolean
-        get() = preferences.getInt(PREF_RECORDING_QUALITY, 0) == 1
+        get() = preferences.getInt(PREF_RECORDING_QUALITY, 1) == 1
         set(value) {
             preferences.edit()
                 .putInt(PREF_RECORDING_QUALITY, if (value) 1 else 0)
-- 
