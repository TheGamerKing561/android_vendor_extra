+#if   defined(CONFIG_FB)
+#if RESUME_IN_WORKQUEUE
+static void gtp_fb_notifier_resume_work(struct work_struct *work)
+{
+	struct goodix_ts_data *ts = container_of(work, struct goodix_ts_data, fb_notify_work);
+	goodix_ts_resume(ts);
+}
