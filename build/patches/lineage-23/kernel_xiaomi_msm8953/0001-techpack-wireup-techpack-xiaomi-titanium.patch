+ssize_t ist30xx_debug_mode_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t size)
+{
+	int ret = 0;
+	int enable;
+	struct ist30xx_data *data = dev_get_drvdata(dev);
