+static u32 endian_mode(void)
+{
+	union {
+		s32 i;
+		s8 c;
+	} endian;
+	endian.i = 1;
+
+	if (1 == endian.c) {
+		return MYBIG_ENDIAN;
+	} else {
+		return MYLITLE_ENDIAN;
+	}
+}
