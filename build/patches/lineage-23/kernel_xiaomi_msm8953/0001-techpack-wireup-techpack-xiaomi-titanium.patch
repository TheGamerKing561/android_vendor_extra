+static void synaptics_rmi4_test_attn (struct synaptics_rmi4_data *rmi4_data,
+		unsigned char intr_mask)
+{
+	if (!f54)
+		return;
+
+	if (f54->intr_mask & intr_mask)
+		queue_work (f54->test_report_workqueue, &f54->test_report_work);
+
+	return;
+}
