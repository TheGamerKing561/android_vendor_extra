+	#endif
+	}
+	show_len = 100;
+	return SUCCESS;
+
+download_fail:
+	if (NULL != dir) {
+		gtp_irq_enable(ts);
+		gtp_fw_startup(ts->client);
+	#if GTP_ESD_PROTECT
+		gtp_esd_switch(ts->client, SWITCH_ON);
+	#endif
+	}
+file_fail:
+	show_len = 200;
+
+	return FAIL;
+}
