+static int fts_charger_detect(struct fts_ts_data *ts_data) {
+	union power_supply_propval pval = {0, };
+	bool was_charging = ts_data->is_charging;
+	int ret = 0;
+
+	if (IS_ERR_OR_NULL(ts_data->charger_psy))
+		return -ENODEV;
