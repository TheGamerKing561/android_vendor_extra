+
+	if (fwu->in_ub_mode) {
+		dev_err (rmi4_data->pdev->dev.parent,
+				"%s: In microbootloader mode\n",
+				__func__);
+		retval = -EINVAL;
+		goto exit;
+	}
+
+	if (!fwu->ext_data_source) {
+		retval = -EINVAL;
+		goto exit;
+	} else {
+		fwu->image = fwu->ext_data_source;
+	}
+
+	retval = fwu_start_write_config ();
+	if (retval < 0) {
+		dev_err (rmi4_data->pdev->dev.parent,
+				"%s: Failed to write config\n",
+				__func__);
