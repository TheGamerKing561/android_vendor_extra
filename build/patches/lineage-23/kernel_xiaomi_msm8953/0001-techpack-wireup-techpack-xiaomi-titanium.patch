+void gup_output_pulse(int t)
+{
+	unsigned long flags;
+
+
+	GTP_GPIO_OUTPUT(gtp_int_gpio, 0);
+	msleep(10);
+	
+	local_irq_save(flags);
+
+	GTP_GPIO_OUTPUT(gtp_int_gpio, 1);
+	msleep(50);
+	GTP_GPIO_OUTPUT(gtp_int_gpio, 0);
+	msleep(t - 50);
+	GTP_GPIO_OUTPUT(gtp_int_gpio, 1);
+
+	local_irq_restore(flags);
+
+	msleep(20);
+	GTP_GPIO_OUTPUT(gtp_int_gpio, 0);
+}
