+	/* query 6 */
+	if (query_0_5->has_rel)
+		offset += 1;
+
+	/* queries 7 8 */
+	if (query_0_5->has_gestures) {
+		retval = synaptics_rmi4_reg_read (rmi4_data,
+				fhandler->full_addr.query_base + offset,
+				query_7_8.data,
+				sizeof (query_7_8.data));
