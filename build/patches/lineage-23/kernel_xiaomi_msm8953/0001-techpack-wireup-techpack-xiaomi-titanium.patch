+	if (!memcmp(opr_buf, "GOODIX_GT9", 10)) {
+		ts->chip_type = CHIP_TYPE_GT9;
+	} else {
+		ts->chip_type = CHIP_TYPE_GT9F;
+	}
+	GTP_INFO("Chip Type: %s", (ts->chip_type == CHIP_TYPE_GT9) ? "GOODIX_GT9" : "GOODIX_GT9F");
+}
