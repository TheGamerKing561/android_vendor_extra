+			return -ENOMEM;
+		}
+		NVT_LOG("create proc/%s Succeeded!\n", NVT_SPI_PEN_DIFF);
+	}
+
+	return 0;
+}
+
+/*
+ ******************************************************
+ * Description:
+ *	Novatek touchscreen extra function proc. file node
+ *	deinitial function.
+ *
+ * return:
+ *	n.a.
+ ******************************************************
