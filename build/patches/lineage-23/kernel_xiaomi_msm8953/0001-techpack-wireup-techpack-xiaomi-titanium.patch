+	}
+
+	pdt_props = kzalloc(sizeof(*pdt_props), GFP_KERNEL);
+ 	if (!pdt_props) {
+ 		retval = -ENOMEM;
+ 		goto exit;
+ 	}
+
+	fwu = kzalloc (sizeof (*fwu), GFP_KERNEL);
+	if (!fwu) {
+		dev_err (rmi4_data->pdev->dev.parent,
+				"%s: Failed to alloc mem for fwu\n",
+				__func__);
