+static int hq_tp_data_dump_proc_open(struct inode *inode, struct file *file)
+{
+	s32 ret = FAIL; /* SUCCESS, FAIL*/
+	struct goodix_ts_data *ts;
+	u16 *raw_buf = NULL;
