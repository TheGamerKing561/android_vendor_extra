+		goto exit;
+	}
+
+	retval = test_sysfs_resume_touch_store (dev, attr, cmd, 1);
+	if (retval < 0)
+		goto exit;
+
+	return count;
+
+exit:
+	rmi4_data->reset_device (rmi4_data, false);
+
+	return retval;
+}
