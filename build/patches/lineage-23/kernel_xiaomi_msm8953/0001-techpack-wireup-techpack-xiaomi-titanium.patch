+	/* queries 24 25 26 27 reserved */
+
+	/* query 28 */
+	if (f55->query_22.has_query28) {
+		retval = synaptics_rmi4_reg_read (rmi4_data,
+				f55->query_base_addr + offset,
+				f55->query_28.data,
+				sizeof (f55->query_28.data));
+		if (retval < 0)
+			return retval;
