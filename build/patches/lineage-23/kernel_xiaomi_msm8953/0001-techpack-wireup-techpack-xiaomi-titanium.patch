+		usleep_range(1000, 1100);
+	}
+
+	if (i >= retry) {
+		NVT_ERR("failed, i=%d, buf[1]=0x%02X\n", i, buf[1]);
+		return -EIO;
+	}
+
+	return 0;
+}
