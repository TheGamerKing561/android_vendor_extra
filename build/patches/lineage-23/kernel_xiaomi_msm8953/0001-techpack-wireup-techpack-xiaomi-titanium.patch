+	for (i = 0; i < ts->y_num; i++) {
+		for (j = 0; j < ts->x_num; j++)
+			seq_printf(m, "%5d, ", nvt_spi_xdata[i * ts->x_num + j]);
+
+		seq_puts(m, "\n");
+	}
+
+#if NVT_SPI_TOUCH_KEY_NUM > 0
+	for (i = 0; i < NVT_SPI_TOUCH_KEY_NUM; i++)
+		seq_printf(m, "%5d, ", nvt_spi_xdata[ts->x_num * ts->y_num + i]);
+
+	seq_puts(m, "\n");
+#endif
+
+	seq_puts(m, "\n\n");
+	return 0;
+}
