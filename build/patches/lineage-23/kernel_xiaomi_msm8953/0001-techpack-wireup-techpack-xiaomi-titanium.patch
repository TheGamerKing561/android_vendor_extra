diff --git a/techpack/xiaomi-titanium/touchscreen/td4310_lansi_e7/Makefile b/techpack/xiaomi-titanium/touchscreen/td4310_lansi_e7/Makefile
new file mode 100644
index 000000000..a8cb38657
--- /dev/null
+++ b/techpack/xiaomi-titanium/touchscreen/td4310_lansi_e7/Makefile
@@ -0,0 +1,18 @@
+#
+# Makefile for the Synaptics DSX touchscreen driver.
+#
+
+# Each configuration option enables a list of files.
+
