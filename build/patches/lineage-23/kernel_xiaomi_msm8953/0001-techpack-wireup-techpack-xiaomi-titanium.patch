+static void gt9xx_leave_short_test(struct i2c_client *client)
+{
+	gtp_reset_guitar(client, 20);
+	msleep(100);
+	gtp_send_cfg(client);
+	SET_INFO_LINE_INFO("");
+	SET_INFO_LINE_INFO("---gtp short test end---");
+}
