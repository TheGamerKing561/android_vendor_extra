+				"%s: No guest code in firmware image\n",
+				__func__);
+		return -EINVAL;
+	}
+
+	if (rmi4_data->sensor_sleep) {
+		dev_err (rmi4_data->pdev->dev.parent,
+				"%s: Sensor sleeping\n",
