+int gtp_gesture_switch(struct input_dev *dev, unsigned int type, unsigned int code, int value)
+{
+	if (type == EV_SYN && code == SYN_CONFIG) {
+		if (value == WAKEUP_OFF) {
+			gtp_gesture_func_on = false;
+		} else if (value == WAKEUP_ON) {
+			gtp_gesture_func_on  = true;
+		}
+	}
+	return 0;
+}
