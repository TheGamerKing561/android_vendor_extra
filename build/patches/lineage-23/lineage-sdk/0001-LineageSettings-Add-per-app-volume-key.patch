From 4bc2f116d09ee15fc2d7e8d61a638629f355d3fc Mon Sep 17 00:00:00 2001
From: mikooomich <mikooomichael@gmail.com>
Date: Mon, 5 Feb 2024 20:46:27 -0500
Subject: [PATCH] LineageSettings: Add per-app volume key

Change-Id: I8f8361ed4c2af36c1aca27dde3a2e61f51d6b304
---
 sdk/src/java/lineageos/providers/LineageSettings.java | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/sdk/src/java/lineageos/providers/LineageSettings.java b/sdk/src/java/lineageos/providers/LineageSettings.java
index 9fe5cb4..971bd83 100644
--- a/sdk/src/java/lineageos/providers/LineageSettings.java
+++ b/sdk/src/java/lineageos/providers/LineageSettings.java
@@ -1044,6 +1044,16 @@ public final class LineageSettings {
         public static final Validator VOLUME_ADJUST_SOUNDS_ENABLED_VALIDATOR =
                 sBooleanValidator;
 
+        /**
+         * Show per-app volume controls in volume hud
+         * Defaults to 0 - Per-app volume controls hidden
+         */
+        public static final String SHOW_APP_VOLUME = "show_app_volume";
+
+        /** @hide */
+        public static final Validator SHOW_APP_VOLUME_VALIDATOR =
+                sBooleanValidator;
+
         /**
          * Navigation controls to Use
          */
@@ -2140,6 +2150,7 @@ public final class LineageSettings {
                     INCREASING_RING_RAMP_UP_TIME_VALIDATOR);
             VALIDATORS.put(VOLUME_ADJUST_SOUNDS_ENABLED,
                     VOLUME_ADJUST_SOUNDS_ENABLED_VALIDATOR);
+            VALIDATORS.put(SHOW_APP_VOLUME, SHOW_APP_VOLUME_VALIDATOR);
             VALIDATORS.put(NAV_BUTTONS, NAV_BUTTONS_VALIDATOR);
             VALIDATORS.put(NAVIGATION_BAR_MENU_ARROW_KEYS,
                     NAVIGATION_BAR_MENU_ARROW_KEYS_VALIDATOR);
