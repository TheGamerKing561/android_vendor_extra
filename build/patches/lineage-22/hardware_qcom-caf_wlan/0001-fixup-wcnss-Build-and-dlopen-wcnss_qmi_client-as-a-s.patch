From cb323f17969105e441dfb85bc3fe696aafd7f032 Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Sat, 30 Nov 2024 19:18:56 +0000
Subject: [PATCH 1/2] fixup! wcnss: Build and dlopen wcnss_qmi_client as a
 shared library

Change-Id: I7b82ec6a8c52cf8a3e6b6225f1f346c8b0de04c6
---
 wcnss-service/wcnss_service.c | 18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/wcnss-service/wcnss_service.c b/wcnss-service/wcnss_service.c
index a8f3497..c716cf8 100644
--- a/wcnss-service/wcnss_service.c
+++ b/wcnss-service/wcnss_service.c
@@ -714,9 +714,9 @@ void dynamic_nv_replace()
 
 #ifdef WCNSS_QMI_OSS
 static void *wcnss_qmi_handle = NULL;
-static int (*wcnss_init_qmi)(void) = NULL;
-static int (*wcnss_qmi_get_wlan_address)(unsigned char *) = NULL;
-static void (*wcnss_qmi_deinit)(void) = NULL;
+static int (*wcnss_init_qmi_ptr)(void) = NULL;
+static int (*wcnss_qmi_get_wlan_address_ptr)(unsigned char *) = NULL;
+static void (*wcnss_qmi_deinit_ptr)(void) = NULL;
 
 static int setup_wcnss_qmi(void)
 {
@@ -731,7 +731,7 @@ static int setup_wcnss_qmi(void)
 
 	dlerror();
 
-	wcnss_init_qmi = dlsym(wcnss_qmi_handle, "wcnss_init_qmi");
+	wcnss_init_qmi_ptr = dlsym(wcnss_qmi_handle, "wcnss_init_qmi");
 	if ((error = dlerror()) != NULL) {
 		ALOGE("Failed to resolve function: %s: %s",
 				"wcnss_init_qmi", error);
@@ -740,7 +740,7 @@ static int setup_wcnss_qmi(void)
 
 	dlerror();
 
-	wcnss_qmi_get_wlan_address = dlsym(wcnss_qmi_handle,
+	wcnss_qmi_get_wlan_address_ptr = dlsym(wcnss_qmi_handle,
 			"wcnss_qmi_get_wlan_address");
 	if ((error = dlerror()) != NULL) {
 		ALOGE("Failed to resolve function: %s: %s",
@@ -750,7 +750,7 @@ static int setup_wcnss_qmi(void)
 
 	dlerror();
 
-	wcnss_qmi_deinit = dlsym(wcnss_qmi_handle, "wcnss_qmi_deinit");
+	wcnss_qmi_deinit_ptr = dlsym(wcnss_qmi_handle, "wcnss_qmi_deinit");
 	if ((error = dlerror()) != NULL) {
 		ALOGE("Failed to resolve function: %s: %s",
 				"wcnss_qmi_deinit", error);
@@ -786,8 +786,8 @@ int main(int argc, char *argv[])
 
 	rc = setup_wcnss_qmi();
 	if (rc == SUCCESS) {
-		if (SUCCESS == (*wcnss_init_qmi)()) {
-			rc = (*wcnss_qmi_get_wlan_address)(wlan_nv_mac_addr);
+		if (SUCCESS == wcnss_init_qmi_ptr()) {
+			rc = wcnss_qmi_get_wlan_address_ptr(wlan_nv_mac_addr);
 			if (rc == SUCCESS) {
 				nv_mac_addr = SUCCESS;
 				ALOGE("WLAN MAC Addr:" MAC_ADDRESS_STR,
@@ -795,7 +795,7 @@ int main(int argc, char *argv[])
 			} else
 				ALOGE("Failed to Get MAC addr from modem");
 
-			(*wcnss_qmi_deinit)();
+			wcnss_qmi_deinit_ptr();
 		}
 		else
 			ALOGE("Failed to Initialize wcnss QMI Interface");
-- 
