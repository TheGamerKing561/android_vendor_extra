From 2c9790203b8ca47dd2954f298ccd3c6bc930976c Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Sat, 16 Nov 2024 10:53:31 +0000
Subject: [PATCH] compat: Provide libutils-v33

Copied from prebuilts/vndk/v33/arm64/*/shared/vndk-sp
and changed SONAME using the following command:
* patchelf-0_9 --set-soname libutils-v33.so libutils-v33.so

Change-Id: Ib91ff45ce3a2f015aad7673fde930b72e540d7c8
---
 Android.bp                     |  18 ++++++++++++++++++
 vndk/v33/arm/libutils-v33.so   | Bin 0 -> 99944 bytes
 vndk/v33/arm64/libutils-v33.so | Bin 0 -> 137312 bytes
 3 files changed, 18 insertions(+)
 create mode 100755 vndk/v33/arm/libutils-v33.so
 create mode 100755 vndk/v33/arm64/libutils-v33.so

diff --git a/Android.bp b/Android.bp
index 505b8bf..7db3ab7 100644
--- a/Android.bp
+++ b/Android.bp
@@ -564,6 +564,24 @@ cc_prebuilt_library_shared {
     check_elf_files: false,
 }
 
+cc_prebuilt_library_shared {
+    name: "libutils-v33",
+    vendor: true,
+    strip: {
+        none: true,
+    },
+    target: {
+        android_arm: {
+            srcs: ["vndk/v33/arm/libutils-v33.so"],
+        },
+        android_arm64: {
+            srcs: ["vndk/v33/arm64/libutils-v33.so"],
+        },
+    },
+    compile_multilib: "both",
+    check_elf_files: false,
+}
+
 cc_library_shared {
     name: "libutils_shim",
     shared_libs: ["libutils"],
diff --git a/vndk/v33/arm/libutils-v33.so b/vndk/v33/arm/libutils-v33.so
