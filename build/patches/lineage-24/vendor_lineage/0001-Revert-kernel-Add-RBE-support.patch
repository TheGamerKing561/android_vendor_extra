From 89539d3c7dd2615182c69fdeb9d4e75a69f8ffa2 Mon Sep 17 00:00:00 2001
From: Giovanni Ricca <giovanniricca@proton.me>
Date: Sun, 13 Sep 2026 23:51:05 +0200
Subject: [PATCH] Revert "kernel: Add RBE support"

This reverts commit b104fc7bed6496f2c2ae4bfab9e93233fb433342.
---
 build/tasks/kernel.mk        |  8 +----
 build/tools/kernel_rbe_cc.sh | 62 ------------------------------------
 config/BoardConfigKernel.mk  | 25 ---------------
 3 files changed, 1 insertion(+), 94 deletions(-)
 delete mode 100755 build/tools/kernel_rbe_cc.sh

diff --git a/build/tasks/kernel.mk b/build/tasks/kernel.mk
index b2f60be..4f19f67 100644
--- a/build/tasks/kernel.mk
+++ b/build/tasks/kernel.mk
@@ -262,18 +262,12 @@ endif
 PATH_OVERRIDE += LD_LIBRARY_PATH=$(TARGET_KERNEL_CLANG_PATH)/lib64:$$LD_LIBRARY_PATH
 PATH_OVERRIDE += PATH=$(TARGET_KERNEL_CLANG_PATH)/bin:$$PATH
 ifeq ($(KERNEL_CC),)
-    KERNEL_CC := CC="$(KERNEL_CC_WRAPPER) clang" LD=ld.lld
+    KERNEL_CC := CC="$(CCACHE_BIN) clang" LD=ld.lld
 endif
 
 # System tools are no longer allowed on 10+
 PATH_OVERRIDE += $(TOOLS_PATH_OVERRIDE)
 
-ifneq ($(KERNEL_RBE_WRAPPER),)
-    # The kernel is built from KERNEL_OUT, not from the top of the tree
-    PATH_OVERRIDE += RBE_exec_root=$(BUILD_TOP)
-    PATH_OVERRIDE += KERNEL_RBE_WRAPPER="$(KERNEL_RBE_WRAPPER)"
-endif
-
 ifneq (,$(filter true, $(TARGET_NEEDS_DTBOIMAGE) $(BOARD_KERNEL_SEPARATED_DTBO)))
     KERNEL_MAKE_FLAGS += DTC_EXT=$(KERNEL_BUILD_OUT_PREFIX)$(DTC)
 endif
diff --git a/build/tools/kernel_rbe_cc.sh b/build/tools/kernel_rbe_cc.sh
deleted file mode 100755
index 07cf22a..0000000
--- a/build/tools/kernel_rbe_cc.sh
+++ /dev/null
@@ -1,62 +0,0 @@
-#!/bin/sh
-#
-# SPDX-FileCopyrightText: 2026 The LineageOS Project
-# SPDX-License-Identifier: Apache-2.0
-#
-
-# The kernel's CC when RBE is enabled, see BoardConfigKernel.mk.
-#
-# reclient only understands an actual compilation, so everything else kbuild
-# runs the compiler for is executed directly, and the -Wp,-MD dependency file
-# has to be declared by hand since reclient doesn't derive it as an output.
-
-compile=
-depfile=
-prev=
-src=
-
-for arg in "$@"; do
-    if [ "$prev" = "-MF" ]; then
-        depfile=$arg
-        prev=
-        continue
-    fi
-    case $arg in
-        -c) compile=true ;;
-        -E | -S | -M | -MM) compile=; break ;;
-        -MF) prev=$arg ;;
-        -Wp,-MD,* | -Wp,-MMD,*) depfile=${arg##*,} ;;
-        -*) ;;
-        *.c | *.S | *.s) src=$arg ;;
-    esac
-done
-
-if [ -z "$KERNEL_RBE_WRAPPER" ] || [ -z "$compile" ] || [ ! -f "$src" ]; then
-    exec "$@"
-fi
-
-# reproxy runs the command with an environment of its own
-cc=$1
-shift
-case $cc in
-    */*) ;;
-    *) cc=$(command -v "$cc") || exit 1 ;;
-esac
-
-if [ -z "$depfile" ]; then
-    exec $KERNEL_RBE_WRAPPER "$cc" "$@"
-fi
-
-# reclient wants output paths relative to the exec root
-case $depfile in
-    /*)
-        output=${depfile#"$RBE_exec_root"/}
-        ;;
-    *)
-        workdir=${PWD#"$RBE_exec_root"}
-        workdir=${workdir#/}
-        output=${workdir:+$workdir/}$depfile
-        ;;
-esac
-
-exec $KERNEL_RBE_WRAPPER "--output_files=$output" "$cc" "$@"
diff --git a/config/BoardConfigKernel.mk b/config/BoardConfigKernel.mk
index 91762a8..545366c 100644
--- a/config/BoardConfigKernel.mk
+++ b/config/BoardConfigKernel.mk
@@ -45,7 +45,6 @@
 #                                          building. Defaults to empty
 #
 #   USE_CCACHE                         = Enable ccache (global Android flag)
-#   USE_RBE                            = Enable RBE (global Android flag)
 
 include vendor/lineage/build/core/utils.mk
 
@@ -96,30 +95,6 @@ ifneq ($(USE_CCACHE),)
     endif
 endif
 
-# build/make/core/rbe.mk is only read while dumping the product config, so the
-# rewrapper flags have to be recreated here
-KERNEL_RBE_WRAPPER :=
-ifneq ($(filter-out false,$(USE_REWRAPPER)),)
-    # An out dir outside of the tree can't be a remote input or output
-    ifneq ($(filter $(BUILD_TOP)/%,$(abspath $(OUT_DIR))),)
-        KERNEL_RBE_WRAPPER := $(abspath $(if $(RBE_DIR),$(RBE_DIR),prebuilts/remoteexecution-client/live))/rewrapper
-        KERNEL_RBE_WRAPPER += --labels=type=compile,lang=cpp,compiler=clang
-        KERNEL_RBE_WRAPPER += --env_var_allowlist=PWD
-        KERNEL_RBE_WRAPPER += --exec_strategy=$(if $(RBE_CXX_EXEC_STRATEGY),$(RBE_CXX_EXEC_STRATEGY),local)
-        KERNEL_RBE_WRAPPER += --compare=$(if $(RBE_CXX_COMPARE),$(RBE_CXX_COMPARE),false)
-        ifneq ($(RBE_platform),)
-            KERNEL_RBE_WRAPPER += --platform=$(RBE_platform),Pool=$(if $(RBE_CXX_POOL),$(RBE_CXX_POOL),default)
-        endif
-    endif
-endif
-
-# ccache can't cache anything behind another wrapper, so it gives way to RBE
-ifneq ($(KERNEL_RBE_WRAPPER),)
-    KERNEL_CC_WRAPPER := $(BUILD_TOP)/vendor/lineage/build/tools/kernel_rbe_cc.sh
-else
-    KERNEL_CC_WRAPPER := $(CCACHE_BIN)
-endif
-
 # Clear this first to prevent accidental poisoning from env
 KERNEL_MAKE_FLAGS :=
 
-- 
2.55.0

