soong_config_module_type {
    name: "lineage_updater_overlay",
    module_type: "runtime_resource_overlay",
    config_namespace: "lineage_extra",
    value_variables: ["product_version_major"],
    properties: ["resource_dirs"],
}

lineage_updater_overlay {
    name: "UpdaterOverlayEXTRA",
    soong_config_variables: {
        product_version_major: {
            resource_dirs: ["%s/res"],
            conditions_default: {
                resource_dirs: ["base/res"],
            },
        },
    },
    manifest: "AndroidManifest.xml",
    product_specific: true,
    certificate: "platform",
    sdk_version: "current",
}
