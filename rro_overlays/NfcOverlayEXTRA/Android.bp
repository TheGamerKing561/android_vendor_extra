soong_config_module_type {
    name: "lineage_nfc_overlay",
    module_type: "runtime_resource_overlay",
    config_namespace: "lineage_extra",
    bool_variables: ["product_has_nfc"],
    properties: ["resource_dirs"],
}

lineage_nfc_overlay {
    name: "NfcOverlayEXTRA",
    soong_config_variables: {
        product_has_nfc: {
            resource_dirs: ["res-nfc"],
            conditions_default: {
                resource_dirs: ["res"],
            },
        },
    },
    product_specific: true,
}
