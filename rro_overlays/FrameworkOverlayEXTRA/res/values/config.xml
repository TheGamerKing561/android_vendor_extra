<resources>
    <string-array name="config_locationExtraPackageNames" translatable="false">
        <!-- Bluetooth -->
        <item>com.android.bluetooth</item>
        <!-- TeleService -->
        <item>com.android.phone</item>
        <!-- CneApp -->
        <item>com.qualcomm.qti.cne</item>
        <!-- ImsService -->
        <item>com.shannon.imsservice</item>
        <!-- MediaTek ImsService -->
        <item>com.mediatek.ims</item>
        <!-- Life360 -->
        <item>com.life360.android.safetymapd</item>
        <!-- SystemUI -->
        <item>com.android.systemui</item>
        <!-- Tethering -->
        <item>com.android.networkstack.tethering</item>
        <!-- GMS location history -->
        <item>com.google.android.gms.location.history</item>
        <!-- Google -->
        <item>com.google.android.googlequicksearchbox</item>
        <!-- Settings -->
        <item>com.android.settings</item>
    </string-array>

    <!--  Maximum number of supported switchable users (excluding Guests & Demo users).
          Does not include profiles. See {@link UserManager#getMaxSwitchableUsers()} for details.

          Setting to 1 disables multiple switchable users (e.g. secondary users).

          To limit the number of any particular user type (whether switchable or not), set the
          appropriate maximum in {@link com.android.internal.R.xml#config_user_types}.

         Note: If > 1, it is expected that UserManager.USER_TYPE_FULL_SECONDARY users are supported
         on the device (at least for testing purposes, even if in practice the UI really only allows
         other switchable types, such as restricted profiles or guests, to be created).
         -->
    <integer name="config_multiuserMaximumUsers">16</integer>

    <!-- Whether safe headphone hearing is enforced by any regulation (e.g.
         EN50332-3, EN50332-2) or not (country specific). -->
    <bool name="config_safe_media_volume_enabled">false</bool>

    <!-- The amount to scale fullscreen snapshots for Overview and snapshot starting windows. -->
    <item name="config_highResTaskSnapshotScale" format="float" type="dimen">0.7</item>

    <!-- The array of account types that accounts in any of these can be set as the default account
         for new raw contacts. -->
    <string-array name="config_rawContactsEligibleDefaultAccountTypes" translatable="false">
        <item>com.google</item>
        <item>at.bitfire.davdroid.address_book</item>
    </string-array>
</resources>
